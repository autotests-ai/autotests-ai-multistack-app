# Match Java's JaCoCo omit of MultistackApplication: WSGI/ASGI entrypoints and
# generated migrations are outside the contract surface.
[run]
branch = false
relative_files = true
omit =
    config/wsgi.py
    config/asgi.py
    manage.py
    */migrations/*
    tests/*
    */test_*.py

[report]
precision = 0
show_missing = true
skip_covered = true
