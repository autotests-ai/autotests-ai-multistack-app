# Match Java's JaCoCo omit of MultistackApplication: entrypoint modules are not
# part of the contract surface and are excluded from the 100% line gate.
[run]
branch = false
relative_files = true
omit =
    wsgi.py
    gunicorn.conf.py
    tests/*
    */test_*.py

[report]
precision = 0
show_missing = true
skip_covered = true
