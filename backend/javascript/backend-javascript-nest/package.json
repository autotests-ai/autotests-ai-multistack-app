{
  "name": "backend-javascript-nest",
  "version": "1.0.0",
  "description": "JavaScript NestJS JSON API mirroring the backend-java-spring contract",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "babel src --out-dir dist",
    "prestart": "npm run build",
    "start": "node dist/main.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@babel/cli": "8.0.4",
    "@babel/core": "8.0.1",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/plugin-transform-class-properties": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@nestjs/testing": "11.1.28",
    "babel-jest": "30.4.1",
    "jest": "30.4.2",
    "supertest": "7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "reflect-metadata"
    ],
    "transform": {
      "\\.js$": "babel-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
