# Root context is for frontend images that need frontend/_shared.
# Backend services use their own context + .dockerignore under backend/*/.

# VCS / CI
.git
.github

# Secrets / docs / OS
.env
.env.*
*.md
**/.DS_Store
**/.idea
**/*.iml

# Build, deps, caches, test artifacts
**/.gradle
**/build
**/bin
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.py[cod]
**/allure-results
**/allure-report
**/test-results
**/playwright-report
**/.pytest_cache

# Not copied into frontend images
backend
tests
deploy
preview

# Frontend: tooling and the local wire embed only. Every product module now has a
# Dockerfile and a compose service, so none of them may be excluded from the context —
# each image copies its own module dir out of this shared root context.
frontend/scripts
frontend/_shared/frontend-javascript-embed
