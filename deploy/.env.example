# Production overrides for docker compose (optional).
# Copy to .env on the server: chmod 600 .env

# Local public entry (edge). Prod host nginx talks to WEB_PORT + BACKEND_*_PORT.
SERVER_PORT=8800
WEB_PORT=8801
BACKEND_JAVA_PORT=8810
BACKEND_FLASK_PORT=8811

JWT_SECRET=change-me-min-32-chars-in-production
