{
  "source": "deploy/matrix.yaml",
  "defaults": {
    "backends": [
      "backend-java-spring"
    ],
    "frontends": [
      "frontend-typescript-react"
    ]
  },
  "all": {
    "backends": [
      "backend-java-spring",
      "backend-kotlin-spring",
      "backend-python-flask",
      "backend-python-fastapi",
      "backend-python-django"
    ],
    "frontends": [
      "frontend-javascript-vanilla",
      "frontend-typescript-react",
      "frontend-typescript-vue"
    ]
  },
  "targets": [
    {
      "kind": "backend",
      "id": "backend-java-spring",
      "module": "backend/java/backend-java-spring",
      "compose_service": "backend-java-spring",
      "image": "reference-app-copy-backend-java-spring:latest"
    },
    {
      "kind": "backend",
      "id": "backend-kotlin-spring",
      "module": "backend/kotlin/backend-kotlin-spring",
      "compose_service": "backend-kotlin-spring",
      "image": "reference-app-copy-backend-kotlin-spring:latest"
    },
    {
      "kind": "backend",
      "id": "backend-python-flask",
      "module": "backend/python/backend-python-flask",
      "compose_service": "backend-python-flask",
      "image": "reference-app-copy-backend-python-flask:latest"
    },
    {
      "kind": "backend",
      "id": "backend-python-fastapi",
      "module": "backend/python/backend-python-fastapi",
      "compose_service": "backend-python-fastapi",
      "image": "reference-app-copy-backend-python-fastapi:latest"
    },
    {
      "kind": "backend",
      "id": "backend-python-django",
      "module": "backend/python/backend-python-django",
      "compose_service": "backend-python-django",
      "image": "reference-app-copy-backend-python-django:latest"
    },
    {
      "kind": "frontend",
      "id": "frontend-javascript-vanilla",
      "module": "frontend/javascript/frontend-javascript-vanilla",
      "compose_service": "frontend-javascript-vanilla",
      "image": "reference-app-copy-frontend-javascript-vanilla:latest"
    },
    {
      "kind": "frontend",
      "id": "frontend-typescript-react",
      "module": "frontend/typescript/frontend-typescript-react",
      "compose_service": "frontend-typescript-react",
      "image": "reference-app-copy-frontend-typescript-react:latest"
    },
    {
      "kind": "frontend",
      "id": "frontend-typescript-vue",
      "module": "frontend/typescript/frontend-typescript-vue",
      "compose_service": "frontend-typescript-vue",
      "image": "reference-app-copy-frontend-typescript-vue:latest"
    }
  ]
}
