# Stage compose overrides (Box3 second project).
# docker compose --project-name autotests-ai-multistack-app-stage --env-file deploy/stage.env …
# yaml `name:` is autotests-ai-multistack-app — without --project-name this file would steal prod.
# Ports = deploy/matrix.yaml publish_port + 10000 (nginx render_vhosts.py STAGE_PORT_OFFSET).

BACKEND_JAVA_PORT=18800
# Same host as prod (Box3). Compose defaults management to 127.0.0.1:8801 — that
# collides with prod java-spring. Offset +10000 like the API port.
BACKEND_JAVA_MANAGEMENT_PORT=127.0.0.1:18801
BACKEND_KOTLIN_PORT=18810
BACKEND_KOTLIN_MANAGEMENT_PORT=127.0.0.1:18910
BACKEND_KOTLIN_KTOR_PORT=18811
BACKEND_KOTLIN_KTOR_MANAGEMENT_PORT=127.0.0.1:18911
BACKEND_FLASK_PORT=18820
BACKEND_FASTAPI_PORT=18821
BACKEND_DJANGO_PORT=18822
BACKEND_GO_GIN_PORT=18830
BACKEND_GO_STDLIB_PORT=18831
BACKEND_JS_EXPRESS_PORT=18840
BACKEND_JS_NEST_PORT=18841
BACKEND_TS_EXPRESS_PORT=18850
BACKEND_TS_NEST_PORT=18851
BACKEND_CSHARP_ASPNET_PORT=18860
# Prod management defaults 8960/8970 (API + 100). Offset +10000 so stage
# does not steal those loopback scrapes when both projects run on Box3.
BACKEND_CSHARP_ASPNET_MANAGEMENT_PORT=127.0.0.1:18960
BACKEND_RUST_AXUM_PORT=18870
BACKEND_RUST_AXUM_MANAGEMENT_PORT=127.0.0.1:18970
FRONTEND_JS_VANILLA_PORT=19800
FRONTEND_JS_REACT_PORT=19801
FRONTEND_JS_ANGULAR_PORT=19802
FRONTEND_JS_VUE_PORT=19803
FRONTEND_JS_JQUERY_PORT=19804
FRONTEND_TS_VANILLA_PORT=19810
FRONTEND_TS_REACT_PORT=19811
FRONTEND_TS_ANGULAR_PORT=19812
FRONTEND_TS_VUE_PORT=19813
FRONTEND_TS_JQUERY_PORT=19814
CI_GATEWAY_PORT=19821
MOCK_GATEWAY_PORT=19911
