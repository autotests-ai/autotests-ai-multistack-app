{
  "name": "autotests-ai-multistack-tests-ts",
  "version": "1.0.0",
  "description": "Playwright pyramid for Multistack (TypeScript; Java-cell coverage, JS page-object shape)",
  "private": true,
  "scripts": {
    "test": "npx playwright test --grep @e2e --grep-invert @screenshot",
    "test:api": "npx playwright test --grep @api",
    "test:infra": "npx c8 --include=src/helpers/env.ts --include=src/helpers/api.ts --include=src/helpers/har-collect.ts --reporter=lcov --reporter=text --report-dir=coverage npx playwright test --grep @infra",
    "test:ui": "npx playwright test --grep @ui --grep-invert @screenshot",
    "test:mock": "npx playwright test --grep @ui --grep-invert @screenshot",
    "test:screenshot": "npx playwright test --grep @screenshot",
    "test:manual": "npx playwright test --grep @manual",
    "t:headed": "npx playwright test --headed --grep @e2e --grep-invert @screenshot",
    "t:chrome": "npx playwright test --project=chromium --grep @e2e --grep-invert @screenshot",
    "typecheck": "tsc --noEmit",
    "code": "npx playwright codegen",
    "allureG": "npx allure generate ./allure-results -o ./allure-report --clean",
    "allureO": "npx allure open ./allure-report",
    "test:meta": "node --test allure/*.test.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@qa-guru/allure-report-kit": "0.3.5",
    "@qa-guru/allure-report-kit-awesome": "3.14.3-6",
    "@qa-guru/allure-report-kit-dashboard": "3.14.3-6",
    "allure": "3.14.3",
    "@qa-guru/allure-notifications": "6.2.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "1.61.1",
    "@types/node": "26.2.0",
    "allure-playwright": "^3.10.2",
    "ajv": "^8.17.1",
    "c8": "^10.1.3",
    "dotenv": "^17.4.2",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "typescript": "7.0.2"
  }
}
