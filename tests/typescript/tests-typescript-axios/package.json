{
  "name": "autotests-ai-multistack-tests-ts-axios",
  "version": "1.0.0",
  "description": "HTTP-only Axios school for Multistack (Vitest; same /api catalog as Java Rest Assured)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:api": "vitest run --tagsFilter api",
    "test:infra": "vitest run --tagsFilter infra",
    "test:manual": "vitest run --tagsFilter manual",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "axios": "^1.12.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "ajv": "^8.17.1",
    "allure-js-commons": "^3.10.2",
    "allure-vitest": "^3.10.2",
    "dotenv": "^17.4.2",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
