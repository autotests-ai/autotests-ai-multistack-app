# Which API the app talks to: prod | stage | ci (ci = laptop compose, local hosts only)
STAND=prod

# Where the session runs: emulator | real | simulator (local Appium) | selenoid | browserstack
DEVICE_HOST=selenoid
# android | ios (ios: simulator, real, browserstack)
PLATFORM=android

# SELENOID_URL=https://user1:1234@selenoid.qa.guru/wd/hub
# ANDROID_APP_URL=https://github.com/autotests-ai/autotests-ai-multistack-app/releases/download/apk/multistack-app.apk
# APPIUM_URL=http://127.0.0.1:4723/wd/hub
# ANDROID_APP= IOS_APP= UDID= DEVICE_NAME= PLATFORM_VERSION=

# BROWSERSTACK_USERNAME= BROWSERSTACK_ACCESS_KEY= BROWSERSTACK_APP_ID= BROWSERSTACK_IOS_APP_ID=

# Attachments — each toggles on its own
# ATTACH_LAST_SCREENSHOT=false ATTACH_PAGE_SOURCE=false ATTACH_DRIVER_LOGS=false ATTACH_VIDEO=false
# ENABLE_VNC=false ENABLE_VIDEO=false
