# Target app
BASE_URL=https://autotests.ai/stack/backend-java-spring/frontend-typescript-react/
API_BASE_URL=https://autotests.ai/stack/backend-java-spring/
# STAND=prod   # prod | stage | mock | ci — used when BASE_URL is unset

# Browser — leave SELENOID_PLAYWRIGHT_URL empty for local Chromium / Chrome for Testing
BROWSER=chrome
BROWSER_VERSION=148.0
BROWSER_SIZE=1740x1080
HEADLESS=true

# Remote Selenoid Playwright (wss, not WebDriver /wd/hub)
# SELENOID_PLAYWRIGHT_URL=wss://selenoid.qa.guru/playwright/playwright-chromium/1.61.1?accessKey=…
SELENOID_PLAYWRIGHT_URL=
ENABLE_VNC=false
ENABLE_VIDEO=false

# Full attachments demo
# ATTACH_FULL=true
# ENABLE_HAR=true
# VIDEO_FOLDER=https://selenoid.qa.guru/video/

# Screenshot compare. Do not set SCREENSHOT_OS=linux on a Mac.
# UPDATE_SCREENSHOTS=true
# SCREENSHOT_BROWSER=chrome
# SCREENSHOT_OS=macos
