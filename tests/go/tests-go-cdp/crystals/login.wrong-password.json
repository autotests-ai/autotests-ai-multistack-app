{
  "id": "login-wrong-password",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Неверный пароль показывает читаемую ошибку",
    "lang": "typescript-playwright",
    "fingerprint": "11adf7e30dedb8d5b7ccbfc311ecddc62e98f284d659877dd7970e1a898b0c7e"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "login"
    },
    {
      "op": "wait",
      "selector": "[data-testid=login-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=login-input]",
      "value": "user1"
    },
    {
      "op": "fill",
      "selector": "[data-testid=password-input]",
      "value": "wrongpassword"
    },
    {
      "op": "click",
      "selector": "[data-testid=submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=error-message]",
      "value": "Wrong login or password"
    }
  ]
}
