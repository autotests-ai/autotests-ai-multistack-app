{
  "id": "register-short-username",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Короткий логин на регистрации показывает ошибку валидации",
    "lang": "typescript-playwright",
    "fingerprint": "42fdf2c4303138a79138f6d3a1536ae47b840ff56b0fdde3665aea52c41db231"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "register"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-login-input]",
      "value": "ab"
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-password-input]",
      "value": "password123"
    },
    {
      "op": "fill",
      "selector": "[data-testid=confirm-password-input]",
      "value": "password123"
    },
    {
      "op": "click",
      "selector": "[data-testid=register-submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=register-error-message]",
      "value": "Login must be at least 3 characters"
    }
  ]
}
