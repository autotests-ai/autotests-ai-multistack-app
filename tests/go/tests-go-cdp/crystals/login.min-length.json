{
  "id": "login-min-length",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Пользователь входит с логином из 3 символов и паролем из 6",
    "lang": "typescript-playwright",
    "fingerprint": "0f1ea0c89ccc3fabe89f5114accf7f26b4f4afa40d4d000a6f088c313b94c81b"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "login"
    },
    {
      "op": "wait",
      "selector": "[data-testid=login-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=login-input]",
      "value": "abc"
    },
    {
      "op": "fill",
      "selector": "[data-testid=password-input]",
      "value": "123456"
    },
    {
      "op": "click",
      "selector": "[data-testid=submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=welcome-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=welcome-message]",
      "value": "Welcome, abc!"
    }
  ]
}
