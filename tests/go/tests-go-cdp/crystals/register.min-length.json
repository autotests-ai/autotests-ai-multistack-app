{
  "id": "register-min-length",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Пользователь регистрируется с логином из 3 символов и паролем из 6",
    "lang": "typescript-playwright",
    "fingerprint": "82f2505f4678bb5b3204ea191a40037ceb09da2652470cbc2cfebcadde21a2db"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "register"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-login-input]",
      "value": "abc"
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-password-input]",
      "value": "123456"
    },
    {
      "op": "fill",
      "selector": "[data-testid=confirm-password-input]",
      "value": "123456"
    },
    {
      "op": "click",
      "selector": "[data-testid=register-submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=welcome-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=welcome-message]",
      "value": "Welcome, abc!"
    }
  ]
}
