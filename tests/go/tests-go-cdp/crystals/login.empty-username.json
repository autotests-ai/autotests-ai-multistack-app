{
  "id": "login-empty-username",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Пустой логин показывает ошибку валидации",
    "lang": "typescript-playwright",
    "fingerprint": "405eebf1e9a68d585a2599f4142581365e95bc876362b2b998dfd8197e4d69c4"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "login"
    },
    {
      "op": "wait",
      "selector": "[data-testid=login-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=password-input]",
      "value": "password1"
    },
    {
      "op": "click",
      "selector": "[data-testid=submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=error-message]",
      "value": "Login is required (minimum 3 characters)"
    }
  ]
}
