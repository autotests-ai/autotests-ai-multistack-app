{
  "id": "register-password-mismatch",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Несовпадение паролей на регистрации показывает ошибку",
    "lang": "typescript-playwright",
    "fingerprint": "a5bfe287b2ce77a2ff37394705bb2233bd57c697cb6fd7228700042cb36823f0"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "register"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-login-input]",
      "value": "newuser"
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-password-input]",
      "value": "password123"
    },
    {
      "op": "fill",
      "selector": "[data-testid=confirm-password-input]",
      "value": "password124"
    },
    {
      "op": "click",
      "selector": "[data-testid=register-submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=register-error-message]",
      "value": "Passwords do not match"
    }
  ]
}
