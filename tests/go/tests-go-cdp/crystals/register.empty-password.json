{
  "id": "register-empty-password",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Пустой пароль на регистрации показывает ошибку валидации",
    "lang": "typescript-playwright",
    "fingerprint": "5ae084fadd4ae87a0375552cedb3ab32cc3eb46d39124b37ac2c34eddefd6679"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "register"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-login-input]",
      "value": "newuser"
    },
    {
      "op": "click",
      "selector": "[data-testid=register-submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=register-error-message]",
      "value": "Password is required (minimum 6 characters)"
    }
  ]
}
