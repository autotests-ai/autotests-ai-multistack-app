{
  "id": "register-username-taken",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Занятый username на регистрации показывает ошибку",
    "lang": "typescript-playwright",
    "fingerprint": "e154bc126af34a23523a2a964d4595f6cd6009477d935df13aeef1c7cca9335e"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "register"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-login-input]",
      "value": "user1"
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-password-input]",
      "value": "password123"
    },
    {
      "op": "fill",
      "selector": "[data-testid=confirm-password-input]",
      "value": "password123"
    },
    {
      "op": "click",
      "selector": "[data-testid=register-submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=register-error-message]",
      "value": "Username already taken"
    }
  ]
}
