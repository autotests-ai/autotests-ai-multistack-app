{
  "id": "register-short-password",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Короткий пароль на регистрации показывает ошибку",
    "lang": "typescript-playwright",
    "fingerprint": "d563fdc456d618db8018273581846cb4cde54241c3d41e5f40bc01497878a30b"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "register"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-login-input]",
      "value": "newuser"
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-password-input]",
      "value": "abc"
    },
    {
      "op": "fill",
      "selector": "[data-testid=confirm-password-input]",
      "value": "abc"
    },
    {
      "op": "click",
      "selector": "[data-testid=register-submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=register-error-message]",
      "value": "Password must be at least 6 characters"
    }
  ]
}
