{
  "id": "register-short-password",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Короткий пароль на регистрации показывает ошибку",
    "lang": "typescript-playwright",
    "fingerprint": "9cdb9b2f16d2d34d5ec090755c80555fa5c4e2891b323090783a680029211e84"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "register"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-login-input]",
      "value": "newuser"
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-password-input]",
      "value": "abc"
