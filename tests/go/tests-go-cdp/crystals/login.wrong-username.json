{
  "id": "login-wrong-username",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Неверный логин показывает читаемую ошибку",
    "lang": "typescript-playwright",
    "fingerprint": "9c92085aa65caa9f5271c526c9a63a4aca14102e837ec41dfd8a9d551087de6e"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "login"
    },
    {
      "op": "wait",
      "selector": "[data-testid=login-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=login-input]",
      "value": "nouser"
    },
    {
      "op": "fill",
      "selector": "[data-testid=password-input]",
      "value": "password1"
    },
    {
      "op": "click",
      "selector": "[data-testid=submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=error-message]",
      "value": "Wrong login or password"
    }
  ]
}
