{
  "id": "register-empty-username",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Пустой логин на регистрации показывает ошибку валидации",
    "lang": "typescript-playwright",
    "fingerprint": "0b8ebfbe4a68952af234b5b45c3e037d007593b783a83af5bdb3e03cd56d6330"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "register"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=register-password-input]",
      "value": "password123"
    },
    {
      "op": "fill",
      "selector": "[data-testid=confirm-password-input]",
      "value": "password123"
    },
    {
      "op": "click",
      "selector": "[data-testid=register-submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "wait",
      "selector": "[data-testid=register-error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=register-error-message]",
      "value": "Login is required (minimum 3 characters)"
    }
  ]
}
