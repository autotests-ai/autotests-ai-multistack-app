{
  "id": "login-short-username",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Короткий логин показывает ошибку валидации",
    "lang": "typescript-playwright",
    "fingerprint": "360c42b360d25ecac368885d9e2e3c38c96015a838f60f19864e4296a33d0b96"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "login"
    },
    {
      "op": "wait",
      "selector": "[data-testid=login-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=login-input]",
      "value": "ab"
    },
    {
      "op": "fill",
      "selector": "[data-testid=password-input]",
      "value": "password1"
    },
    {
      "op": "click",
      "selector": "[data-testid=submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=error-message]",
      "value": "Login must be at least 3 characters"
    }
  ]
}
