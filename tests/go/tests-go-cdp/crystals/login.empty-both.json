{
  "id": "login-empty-both",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Пустые логин и пароль показывают ошибку валидации",
    "lang": "typescript-playwright",
    "fingerprint": "ca1f88ecb0a8003981d3c924e24930940ad9ef2038c271582b51a3feabad9466"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "login"
    },
    {
      "op": "wait",
      "selector": "[data-testid=login-form]",
      "timeout_ms": 5000
    },
    {
      "op": "click",
      "selector": "[data-testid=submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=error-message]",
      "value": "Login and password are required (minimum 3 and 6 characters)"
    }
  ]
}
