{
  "id": "login-short-password",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Короткий пароль показывает ошибку валидации",
    "lang": "typescript-playwright",
    "fingerprint": "d6a468342bb08304ccbcebcca0ba160c5df75410c6f79c801c140a480d766eb8"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "login"
    },
    {
      "op": "wait",
      "selector": "[data-testid=login-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=login-input]",
      "value": "user1"
    },
    {
      "op": "fill",
      "selector": "[data-testid=password-input]",
      "value": "123"
    },
    {
      "op": "click",
      "selector": "[data-testid=submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=error-message]",
      "value": "Password must be at least 6 characters"
    }
  ]
}
