{
  "id": "login-empty-password",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Пустой пароль показывает ошибку валидации",
    "lang": "typescript-playwright",
    "fingerprint": "0aee45d11efbf6f2cc315a21ccad0a5b8ac209de07cf86293783e85fa7343dd5"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "login"
    },
    {
      "op": "wait",
      "selector": "[data-testid=login-form]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=login-input]",
      "value": "user1"
    },
    {
      "op": "click",
      "selector": "[data-testid=submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "wait",
      "selector": "[data-testid=error-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "match": "contains",
      "normalize_whitespace": true,
      "selector": "[data-testid=error-message]",
      "value": "Password is required (minimum 6 characters)"
    }
  ]
}
