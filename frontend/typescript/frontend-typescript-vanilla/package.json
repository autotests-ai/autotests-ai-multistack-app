{
  "name": "frontend-typescript-vanilla",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--no-experimental-webstorage ALLURE_LABEL_epic=reference-app-copy ALLURE_LABEL_layer=component ALLURE_LABEL_scope=frontend-typescript-vanilla ALLURE_LABEL_framework=vanilla_jsdom vitest run",
    "test:smoke": "npm test -- --tagsFilter smoke",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "26.2.0",
    "allure-js-commons": "^3.10.2",
    "allure-vitest": "^3.10.2",
    "jsdom": "^30.0.1",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
