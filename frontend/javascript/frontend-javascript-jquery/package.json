{
  "name": "frontend-javascript-jquery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "preview": "node scripts/dev-server.mjs",
    "build": "node -e \"console.log('static module — nothing to bundle; the Dockerfile overlays the UI runtime and serves these files as-is')\"",
    "test": "NODE_OPTIONS=--no-experimental-webstorage ALLURE_LABEL_epic=autotests-ai-multistack-app ALLURE_LABEL_layer=component ALLURE_LABEL_scope=frontend-javascript-jquery ALLURE_LABEL_framework=jquery_jsdom vitest run",
    "test:watch": "vitest",
    "vendor:jquery": "node -e \"require('node:fs').copyFileSync('node_modules/jquery/dist/jquery.min.js', 'vendor/jquery.min.js')\""
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.3",
    "allure-js-commons": "^3.10.2",
    "allure-vitest": "^3.10.2",
    "jquery": "^4.0.0",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
}
